# ============================================================
# EP LEADS - Environment configuration
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file or paste real secrets into source code.
# ============================================================

# --- App ---
ENV=production
DEBUG=false
SECRET_KEY=replace-with-a-long-random-string   # e.g. `openssl rand -hex 32`
FRONTEND_ORIGIN=http://localhost:5173

# --- Database ---
POSTGRES_DB=ep_leads
POSTGRES_USER=ep_leads
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+asyncpg://ep_leads:replace-with-a-strong-password@postgres:5432/ep_leads
DATABASE_URL_SYNC=postgresql+psycopg2://ep_leads:replace-with-a-strong-password@postgres:5432/ep_leads

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- AI (Anthropic Claude) ---
# Get a key at https://console.anthropic.com/ - required for tender analysis,
# AI sales assistant, and project-signal classification. Without it those
# features return a clear "not configured" error instead of failing silently.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Search provider (choose one) ---
SEARCH_PROVIDER=serper   # serper | bing
SERPER_API_KEY=
BING_API_KEY=

# --- Email (SMTP) - used for alert delivery ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@your-domain.co.il
SMTP_USE_TLS=true

# --- Initial admin user (used once by the seed script) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=מנהל מערכת

# --- Lead score thresholds ---
LEAD_SCORE_THRESHOLD_HOT=90
LEAD_SCORE_THRESHOLD_HIGH=75
LEAD_SCORE_THRESHOLD_MEDIUM=55
